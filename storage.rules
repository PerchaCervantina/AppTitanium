rules_version = '2';

// Reglas de seguridad de Firebase Storage para Titanium.
//
// Cómo pegarlas: Consola de Firebase -> tu proyecto -> Storage -> pestaña
// "Rules" -> pega este contenido entero -> Publicar.
//
// Mismo criterio que firestore.rules: lectura pública de las imágenes
// (para que se vean en la app), escritura solo si el email de quien sube
// la imagen está en Firestore, en `admins/{email}`, con active = true.
service firebase.storage {
  match /b/{bucket}/o {

    function isActiveAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.token.email)).data.active == true;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }
  }
}
